# Optional: enables AI-assisted draft creation from the topic pool.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: enables confirmed Right Codes image generation from a draft prompt.
OPENAI_API_KEY=
OPENAI_IMAGE_GENERATIONS_URL=https://api.site/v1/images/generations
OPENAI_IMAGE_TASKS_URL=https://api.site/v1/tasks
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# Optional Jina Reader fallback after direct article fetching fails. It is
# enabled by default and can be disabled with JINA_READER_ENABLED=false.
JINA_READER_ENABLED=true
# JINA_READER_BASE_URL=https://r.jina.ai
# JINA_API_KEY=
# JINA_READER_TIMEOUT_MS=45000

# Optional: external WeKnora deployment. Built-in managed mode is the default
# and does not need these values.
# WEKNORA_MODE=external
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_TENANT_ID=
WEKNORA_KNOWLEDGE_BASE_IDS=

# Optional: creates an official WeChat Article draft after an explicit user action.
# The server's public egress IP must be in the Official Account IP allowlist, and
# the account must have material-upload and draft APIs enabled.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional data root; the existing ~/xhs-home remains the default.
# DRAFT_STUDIO_HOME=/absolute/path/to/draft-studio-data
# Optional build output directory (use the same value for build and start).
# DRAFT_STUDIO_DIST_DIR=.next-production

# 可选：视频渠道。未指定时使用数据目录下 runtime/manimgl 中的环境。
# 先运行 bun run setup:video；系统还需 FFmpeg、OpenGL 和中文字体。
# MANIMGL_BIN=/absolute/path/to/manimgl
MANIMGL_FONT=PingFang SC
